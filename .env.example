# Copy this file to .env.local (frontend + `vercel dev`) and fill in real values.
# Never commit the filled-in file — secrets belong only in .env.local or your
# Vercel project's Environment Variables.

# --- Frontend (Vite, exposed to the browser) ---
# Used only for Supabase Auth (owner login) — see src/store/useOwnerAuth.ts.
# All business data goes through the backend below, never through these keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (api/index.py, server-only — never exposed to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SUPABASE_URL=
# Secret key or legacy service_role key — bypasses RLS, server-side only.
SUPABASE_SERVICE_KEY=
# seed.sql's default store id: 11111111-1111-4111-8111-111111111111
DEFAULT_STORE_ID=
# Comma-separated origins if the frontend is ever hosted separately;
# leave empty when frontend and API share the same Vercel domain.
ALLOWED_ORIGINS=

# --- VNPay (remote pre-order + prepay pickup) ---
# Sandbox test merchant — swap for a real merchant account before charging
# real money. Register at https://sandbox.vnpayment.vn to get your own.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Must be a page on your deployed frontend, e.g. https://yourapp.vercel.app/pickup-result
VNPAY_RETURN_URL=
# Only used if a store's menu currency is USD (menu prices aren't stored in
# VND today) — VNPay settles in VND only. Set the real rate, or better,
# switch the store's menu currency to VND for accurate production pricing.
USD_TO_VND_RATE=25000

# Lets the customer-facing pickup-result page "pay" an awaiting_payment
# order with one tap, no real bank transfer or VNPay round-trip — for
# previewing the post-payment screens while testing/demoing. Leave unset
# (or false) once a store accepts real payments: anyone with an
# order_group_id could otherwise mark their own order paid for free.
ALLOW_TEST_PAYMENT_CONFIRM=false

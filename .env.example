# Copy this file to .env.local (frontend + `vercel dev`) and fill in real values.
# Never commit the filled-in file — secrets belong only in .env.local or your
# Vercel project's Environment Variables.

# --- Frontend (Vite, exposed to the browser) ---
# Used only for Supabase Auth (owner login) — see src/store/useOwnerAuth.ts.
# All business data goes through the backend below, never through these keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Backend (api/index.py, server-only — never exposed to the browser) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
SUPABASE_URL=
# Secret key or legacy service_role key — bypasses RLS, server-side only.
SUPABASE_SERVICE_KEY=
# seed.sql's default store id: 11111111-1111-4111-8111-111111111111
DEFAULT_STORE_ID=
# Comma-separated origins if the frontend is ever hosted separately;
# leave empty when frontend and API share the same Vercel domain.
ALLOWED_ORIGINS=
